ENV=local
LOG_LEVEL=INFO

# Infrastructure Service Broker Connections
DATABASE_URL=postgresql+asyncpg://airwatch:airwatch@postgres:5432/airwatch
POSTGRES_USER=airwatch
POSTGRES_PASSWORD=airwatch
POSTGRES_DB=airwatch

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1

SLA_P1_SECONDS=60
SLA_P2_SECONDS=300
DEDUP_RADIUS_METERS=500
DEDUP_WINDOW_MINUTES=30
AI_TIMEOUT_SECONDS=6
